# Database Credentials
DB_NAME=lms_db
DB_USERNAME=lms_user
DB_PASSWORD=your_postgres_password_here

# MinIO Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password_here

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# First ADMIN account (used only when no ADMIN exists in the database)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Super Admin
# Set true for one startup to reset the password of the existing ADMIN matching the email above.
# Remove the flag or set it to false immediately after the backend starts successfully.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# Google OAuth client ID (use the same client ID in the frontend)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# VNPay Sandbox credentials (obtain these from your VNPay merchant account)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payment/vnpay/return
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=